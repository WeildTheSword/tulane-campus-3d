# downloaded survey data and built models are large; regenerate them with the pipeline (or track with Git LFS)
data/*
!data/.gitkeep
!data/lidar/
data/lidar/*
!data/lidar/.gitkeep
# curated facade specs and the CC-licensed reference photos they were measured from (see data/photos/ATTRIBUTION.md)
!data/facades/
!data/facades/*.json
!data/photos/
!data/photos/**
out/*
!out/.gitkeep
*.laz
*.las
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/
.DS_Store
.venv/
