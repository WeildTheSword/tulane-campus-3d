# downloaded survey data and built models are large; regenerate them with the pipeline (or track with Git LFS)
data/*
!data/.gitkeep
!data/lidar/
data/lidar/*
!data/lidar/.gitkeep
# curated facade specs are results, not downloads (photos under data/photos/ stay ignored and re-fetchable)
!data/facades/
!data/facades/*.json
out/*
!out/.gitkeep
*.laz
*.las
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/
.DS_Store
.venv/
